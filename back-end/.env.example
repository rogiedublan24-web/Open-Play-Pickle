PORT=3000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/pickleball
# MongoDB Atlas (palitan ang <user>, <password>, <cluster>):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pickleball?retryWrites=true&w=majority

# Mahabang random na string. Para gumawa ng isa:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change-this-to-a-long-random-string

# Mga website na pinapayagang tumawag sa API (comma-separated, walang trailing slash)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

DEFAULT_MAX_PLAYERS=16